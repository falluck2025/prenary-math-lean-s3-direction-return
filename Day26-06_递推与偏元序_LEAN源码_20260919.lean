namespace PrenaryS006

-- 递推：z_{n+1} = z_n + ε_n
/-- 递推（偏元序的载体）：每一步在序号位上加一个残差。 -/
def Recur (ε z : ℤ → ℂ) : Prop := ∀ n : ℤ, z (n + 1) = z n + ε n

-- 定理 17（位不精确）：走一步就留差
/-- 定理 17：残差非零 ⟹ 相邻两步的位不同。 -/
theorem recur_step_leaves_residual {ε z : ℤ → ℂ} (hr : Recur ε z)
    (n : ℤ) (hε : ε n ≠ 0) : z (n + 1) ≠ z n := by
  rw [hr n]
  intro h
  exact hε (by simpa using h)

-- 定理 18（累积）：两步的位变化是两步残差之和
/-- 定理 18：从 `n` 到 `n+2`，位的变化等于两步残差之和。 -/
theorem recur_two_step {ε z : ℤ → ℂ} (hr : Recur ε z) (n : ℤ) :
    z (n + 1 + 1) = z n + (ε n + ε (n + 1)) := by
  rw [hr (n + 1), hr n]
  ring

-- 定理 19（序与位分层）：序号本身不带残差
/-- 定理 19：序号是对象层的静态标记 —— 它自身不带残差；
    只有「走一步」（序号增加）才留差（动作层）。 -/
theorem index_has_no_residual (n : ℤ) :
    (n : ℂ) - (n : ℂ) = 0 := sub_self _

end PrenaryS006
